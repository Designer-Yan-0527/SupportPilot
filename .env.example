# 复制为 .env 后按需修改；不要提交 .env 到仓库
# 相对路径按启动命令所在目录解析，建议始终在项目根目录执行

SUPPORTPILOT_CORPUS_DIR=data/corpus
SUPPORTPILOT_QUESTIONS_FILE=data/eval/questions.json
SUPPORTPILOT_RESULTS_DIR=artifacts/eval

# 切分参数：300 字符约等于 300 token（中文近似 1 字 1 token）
SUPPORTPILOT_FIXED_SIZE=300
SUPPORTPILOT_FIXED_OVERLAP=50
SUPPORTPILOT_MAX_CHARS=300
SUPPORTPILOT_MIN_CHARS=120
